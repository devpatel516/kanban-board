# The URI MongoDB gives you when you create a cluster (or "mongodb://localhost:27017/kanban" for local)
MONGODB_URI=mongodb://localhost:27017/kanban

# The port this Express server listens on – change if 5000 is already taken on your machine
PORT=5000

# The URL of the React app – used by CORS so the browser is allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Replace this placeholder with a random private value. Keep it out of Git.
AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
